{
  "name": "@em.vrn/jev-cms",
  "version": "0.1.0",
  "description": "On-demand Jev (TypeSafe System One) question catalog for CMS-style content — classify, gate, and judge your own content by id, in your own app.",
  "keywords": [
    "jev",
    "typesafe",
    "cms",
    "content-moderation",
    "classification",
    "llm"
  ],
  "homepage": "https://github.com/EmilianoVeron/jev-cms#readme",
  "bugs": {
    "url": "https://github.com/EmilianoVeron/jev-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilianoVeron/jev-cms.git"
  },
  "license": "MIT",
  "author": "Emiliano Veron",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "catalog"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
